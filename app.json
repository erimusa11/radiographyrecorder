{
  "expo": {
    "name": "Radiography Recorder",
    "slug": "radiographyrecorder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "radiographyrecorder",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#191919",
    "ios": {
      "bundleIdentifier": "com.eri.radiographyrecorder",
      "supportsTablet": false
    },
    "android": {
      "package": "com.eri.radiographyrecorder",
      "allowBackup": false,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#191919",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#191919",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "95893a29-01c5-4204-84dd-9ef29ccc38b4"
      }
    },
    "owner": "erimusa11"
  }
}
